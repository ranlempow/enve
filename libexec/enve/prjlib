parse_semver() {
    semver=$1
    semver=${semver#"v"}
    semver=${semver%%"+"*}
    VER_PRERELEASE=${semver#*"-"}
    semver=${semver%"-$VER_PRERELEASE"}
    IFS="." read -r VER_MAJOR VER_MINOR VER_HOTFIX <<EOF
$semver
EOF
    if [ -z "${allownull:-}" ]; then
        VER_MINOR=${VER_MINOR:-0}
        VER_HOTFIX=${VER_HOTFIX:-0}
    fi
    case $VER_MAJOR in
        [0-9]*);;
        *) return 1;;
    esac
    case $VER_MINOR in
        [0-9]*|'');;
        *) return 1;;
    esac
    case $VER_HOTFIX in
        [0-9]*|'');;
        *) return 1;;
    esac
}

sort_semver() {
    echo "$1" | while read -r v; do
        if [ -n "$v" ]; then
            parse_semver "$v" || {
                _error "unkonwn semver '$v'"
                return 1
            }
            printf "%10d%10d%10d%40s:%s\\n" \
                "$VER_MAJOR" "$VER_MINOR" "$VER_HOTFIX" "$VER_PRERELEASE" "$v"
        fi
    done | sort | while IFS=: read -r cols v; do
        echo "$v"
    done
}

is_left_semver_greater() {
    # 0: left greater
    # 1: equal
    # 2: right greater

    allownull=1 parse_semver "$1" || {
        _error "unkonwn semver '$1'"
        return 1
    }
    leftmajor=$VER_MAJOR
    leftminor=$VER_MINOR
    lefthotfix=$VER_HOTFIX
    leftpre=$VER_PRERELEASE
    allownull=1 parse_semver "$2" || {
        _error "unkonwn semver '$2'"
        return 1
    }

    if [ "$leftmajor" -gt "$VER_MAJOR" ] ; then
        return 0
    elif [ "$leftmajor" -lt "$VER_MAJOR" ] ; then
        return 2
    fi

    if [ -z "$leftminor$VER_MINOR" ]; then
        return 1
    elif [ -z "$VER_MINOR" ]; then
        return 2
    elif [ -z "$leftminor" ]; then
        return 0
    elif [ "$leftminor" -gt "$VER_MINOR" ]; then
        return 0
    elif [ "$leftminor" -lt "$VER_MINOR" ]; then
        return 2
    fi

    if [ -z "$lefthotfix$VER_HOTFIX" ]; then
        return 1
    elif [ -z "$VER_HOTFIX" ]; then
        return 2
    elif [ -z "$lefthotfix" ]; then
        return 0
    elif [ "$lefthotfix" -gt "$VER_HOTFIX" ]; then
        return 0
    elif [ "$lefthotfix" -lt "$VER_HOTFIX" ]; then
        return 2
    fi

    if [ "$leftpre" = "$VER_PRERELEASE" ]; then
        return 1
    elif [ -z "$leftpre" -a -n "$VER_PRERELEASE" ]; then
        return 0
    elif [ -n "$leftpre" -a -z "$VER_PRERELEASE" ]; then
        return 2
    else
        read -r line <<EOF
$(sort_semver "$1${newl}$2")
EOF
        if [ "$line" = "$1" ]; then
            return 0
        else
            return 2
        fi
    fi
}


gitignore_walk() {
    # 完整執行所有的gitignore流程

    targetdir=$(normalize "$1")
    shift
    git_basic_info "$targetdir"
    # return: gitdir absgitdir worktree_prefix

    ARGSTR2="'-name' '.git' -prune -o"
    # [ -n "$gitdir" ] || {
    #     _error "'$targetdir' is not a git controlled directory"
    #     return 1
    # }
    if [ -n "$gitdir" ]; then
        ARGSTR2="${ARGSTR2} '-path' '$absgitdir' -prune -o"
    fi
    global="${XDG_CONFIG_HOME:-"$HOME/.config"}/git/ignore"
    if [ -f "$global" ]; then
        fast_readtext "$global"
        ignores=$text
        build_gitignore_to_find_logic "$targetdir" "$ignores" "$@"
        ARGSTR2="${ARGSTR2} ${ARGSTR}"
    fi
    if [ -n "$gitdir" ] && [ -f "$gitdir/info/exclude" ]; then
        fast_readtext "$gitdir/info/exclude"
        ignores=$text
        build_gitignore_to_find_logic "$targetdir" "$ignores" "$@"
        ARGSTR2="${ARGSTR2} ${ARGSTR}"
    fi
    worktree=${targetdir%"/${worktree_prefix%"/"}"}
    while read -r ignorefile; do
        if [ -f "$ignorefile" ]; then
            fast_readtext "$ignorefile"
            ignores=$text
            prefix="${ignorefile%"/.gitignore"}"
            build_gitignore_to_find_logic "$prefix" "$ignores" "$@"
            ARGSTR2="${ARGSTR2} ${ARGSTR}"
        fi
    done <<EOF
$(find "$worktree" -name '.gitignore')
EOF

    ARGSTR=$ARGSTR2
    for a in "$@"; do
        fast_append_argument_quote2 "$a"
    done
    _trace " Run" find "$targetdir" "$ARGSTR"
    eval find \"\$targetdir\" "$ARGSTR"

}


gitignore_ls() {
    long_format=
    ignores=
    dir=
    name=
    while [ $# -gt 0 ]; do
        case $1 in
            --long) long_format=1; shift;;
            --ignore) ignores=${2:-}${newl}; shift 2;;
            *)
                if [ -z "$dir" ]; then
                    dir=$(canonicalize_symlinks "$1")
                else
                    name=$1
                fi
                shift
        esac
    done
    set --
    while read -r ig; do
        if [ -n "$ig" ]; then
            set -- "$@" -path "$ig" -prune -o
        fi
    done<<EOF
$ignores
EOF
    if [ -n "$name" ]; then
        set -- "$@" -name "$name"
    else
        set -- "$@" -type f
    fi
    if [ -n "$long_format" ]; then
        find "$dir" "$@" -exec ls -l {} +
    else
        find "$dir" "$@" -print
    fi
}



get_month() {
    case $m in
    Jan) m=01;;
    Feb) m=02;;
    Mar) m=03;;
    Apr) m=04;;
    May) m=05;;
    Jun) m=06;;
    Jul) m=07;;
    Aug) m=08;;
    Sep) m=09;;
    Oct) m=10;;
    Nov) m=11;;
    Dec) m=12;;
    esac
}

get_days() {
    case $d in
        [0-9]) d=0$d;;
    esac
}

rewrite_hardlink() {
    while read -r p n u g s m d t f; do
        if [ -n "$f" ]; then
            printf '%s - %s %s %s %s %s %s %s\n' \
                 "$p" "$u" "$g" "$s" "$m" "$d" "$t" "$f"
        fi
    done
}

rewrite_datetime() {
    nowyear=$(date +%Y)
    nowmonth=$(date +%m)
    while read -r p n u g s m d t f; do
        if [ -n "$f" ]; then
            get_month
            get_days
            if [ -n "${t##*:*}" ]; then
                y=$t
                h=0
                t=0
            else
                if [ ${m##0} -gt $((${nowmonth##0} + 1)) ]; then
                    y=$(($nowyear - 1))
                else
                    y=$nowyear
                fi
                h=${t%:*}
                t=${t#"$h":}
            fi
            printf '%s %s %s %s %s %s %s\n' \
                 "$p" "$n" "$u" "$g" "$s" "$y-$m-${d}T${h}:${t}:00" "$f"
        fi
    done
}

