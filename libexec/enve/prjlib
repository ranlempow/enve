readlines_to_variables() {
    text=$1
    shift
    while read -r var; do
        if [ -z "${1:-}" ]; then
            break
        fi
        eval "$1=\"\$var\""
        shift
    done <<EOF
$text
EOF
}

read_to_variables() {
    ifs=$1
    line=$2
    shift 2
    IFS="$ifs" read -r "$@" <<EOF
${line}
EOF
}

git_last_version() {
    vers=
    while read -r semver; do
        if parse_semver "$semver"; then
            vers=$vers${semver#"v"}$newl
        fi
    done <<EOF
$(git -C "$1" tag --list 'v*')
EOF
    sorted_vers=$(sort_semver "$vers")
    read -r SEMVER <<EOF
$sorted_vers
EOF
}

git_basic_info() {
    readlines_to_variables \
        "$(git -C "$1" rev-parse --git-dir --absolute-git-dir --show-prefix 2>/dev/null)" \
        gitdir absgitdir worktree_prefix
}

git_info() {
    git_basic_info "$1"

    if [ -n "$gitdir" ]; then
        if [ -z "$worktree_prefix" ]; then
            # project on git top-level folder
            mainline=$(git -C "$1" rev-parse --symbolic-full-name refs/remotes/origin/HEAD || true)
            mainline=${mainline#refs/remotes/origin/}
            if [ -n "$mainline" ]; then
                # parse --left-right line `${left}${tab}${right}${newl}`
                # left: local, right: remote
                read_to_variables "$tab" \
                    "$(git -C "$1" rev-list --count --left-right @{upstream}...$mainline)" \
                    local_mainline remote_mainline
            else
                if [ -e "$gitdir/refs/heads/master" ]; then
                    mainline=master
                elif [ -e "$gitdir/refs/heads/main" ]; then
                    mainline=main
                fi
            fi
            head=$(git -C "$1" symbolic-ref HEAD || true)
            if [ -n "$head" ]; then
                read_to_variables "$tab" \
                    "$(git -C "$1" rev-list --count --left-right @{upstream}...HEAD)" \
                    local_branch remote_branch
            else
                head=$(git -C "$1" describe --tags --exact-match HEAD 2>/dev/null) || \
                head=$(git -C "$1" rev-parse --short HEAD 2>/dev/null)
            fi
            echo "$local_main $remote_main"
            echo "$local_branch $remote_branch"
        else
            # project is subproject
            :
        fi
        baseignore=$(git -C "$1" status --porcelain --ignored -- .)
        if [ "${baseignore#!!}" != "$baseignore" ] ; then
            # project is subproject but ignore
            :
        else
            # project is tracked
            treedirty=
            git -C "$1" diff --no-ext-diff --quiet --relative || treedirty=1
            cachedirty=
            git -C "$1" diff --no-ext-diff --cached --quiet --relative || cachedirty=1
        fi

        # conflict="" # state indicator for unresolved conflicts
        # if [ "$(git ls-files --unmerged 2>/dev/null)" ]; then
        #     conflict="|CONFLICT"
        # fi
    fi
}

git_history() {
    git -C "$1" log -40 --graph --date-order \
        --format="%C(auto)%h%d %s (%ar)" \
        --branches='request/*' ${mainline:-} HEAD
}

project_detect_type() {
