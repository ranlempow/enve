    # 最後更新時間
    get_last_modified
    # 程式碼行數統計
    get_cloc

    types=
    types=${types}${nodejs:+"${types:+ }"js}
    types=${types}${python:+"${types:+ }"py}

    path=${1#${root:+"$root"/}}
    echo "$path [${types}] $gitdir $prefix [${last_datetime}] $top_lang: $top_lang_line_count"
