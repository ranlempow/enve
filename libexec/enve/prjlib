read_project_toml() {
    # 取得 Python: pyproject.toml 的名稱與版本
    while read -r line; do
        _value=${line#*\"}
        _value=${_value%\""${_value#*\"}"}
        case $line in
            name\ =\ *) PRJNAME=${_value};;
            version\ =\ *) PRJVER=${_value};;
        esac
    done < "$1"
    unset line _value
}

read_project_json() {
    # 取得 Nodejs: package.json 的名稱與版本
    while read -r line; do
        line=${line#*\"}
        _value=${line#*\"}
        _value=${_value#*\"}
        _value=${_value%\""${_value#*\"}"}
        case $line in
            name\"\:*) PRJNAME=${_value};;
            version\"\:*) PRJVER=${_value};;
        esac
    done < "$1"
    unset line _value
}

read_markdown_section() {
    # 取得 markdown 文件中其中一個段落，並且回傳下個段落的名稱
    found=
    title=
    content=
    pattern=$2
    [ -n "$pattern" ] || return 1

    {
        while read -r mark title; do
            if [ -z "$mark" -o -z "$title" ]; then
                continue
            fi
            case $mark in
                \#) ;;
                \#\#) ;;
                *) continue ;;
            esac
            if [ -z "${title##"$pattern"*}" ]; then
                found=1
                break
            fi
        done
        [ -z "$found" ] && return 1
        while read -r line; do
            case $line in
                \#\ *) breaker=${line#\# } ;;
                \#\#\ *) breaker=${line#\#\# } ;;
                *)
                    content=$content$line$newl
                    continue;;
            esac
            return 0
        done
    } < "$1"
}

