abort() {
  printf "%s\n" "$@" >&2
  exit 1
}

shell_join() {
    printf "%s" "$1"
    shift
    for s in "$@"; do
        replace " " "\\ "
        printf " "
        printf "%s" "$s"
    done
}

execute() {
    if ! "$@"; then
        abort "$(printf "Failed during: %s" "$(shell_join "$@")")"
    else
        printf "execute %s\\n" "$(shell_join "$@")"
    fi
}

