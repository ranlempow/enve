ARGSTR=
while [ $# -gt 0 ]; do
    case $1 in
        -R|-r|--recursive)      shift 1;;
        -p)                     preserve=1; shift 1;;
        -L|--dereference)       link=follow; shift 1;;
        -l|-d|--no-dereference) link=no-follow; shift 1;;
        -f)                     all_force=1; shift 1;;
        --remove-destination)   all_force=remove; shift 1;;
        -n|--dry-run)           dryrun=1; shift 1;;
        --progress)             progress=1; shift 1;;
        --debug)                debug=1; shift 1;;
        -v)                     verbose=1; shift 1;;
        -T)                     directory=0; shift 1;;
        -t|--target-directory|--target-directory=*)
            case $1 in
                --target-directory==*) directory=1; shift 1; dest=${1#"--target-directory="};;
                *)
                    case ${2:-} in -*|'')
                            die "you must supply a DEST after $1" ;; esac
                    directory=1; dest=$2 shift 2;;
            esac
            ;;
        --help)
                print_program_help "$ENVE_PROGRAM" >&2
                quiet_exit 1
            ;;
        -*)
                die "unknown option: $1"
            ;;
        *)
                fast_append_argument_quote2 "$1"
                shift 1
            ;;
    esac
done

eval set -- "$ARGSTR"
if [ "${directory:-0}" -eq 0 ] && [ $# -ge 2 ]; then
    ARGSTR=
    while [ $# -gt 1 ]; do
        fast_append_argument_quote2 "$1"
        shift 1
    done
    dest="$1"
    eval set -- "$ARGSTR"
fi

if ! dst_uri="$dest" make_multiple_action "$@" >/dev/null; then
    return 1
fi
eval set -- "$ARGSTR"
if [ -n "${debug:-}" ]; then
    for arg in "$@"; do
        echo "$arg"
    done
fi
script=$(perfect_compile "$@")

if [ -n "${dryrun:-}" ]; then
    echo "$script"
else
    echo "$script"
fi

