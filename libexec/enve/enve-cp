#!/bin/sh
#
# Usage: enve-clone [OPTIONS] <repo>[#VERSION] [PATH]
#        enve-clone [OPTIONS] <repo>[#VERSION] tmp|prjtmp
#        enve-clone [OPTIONS] --studio <repo> [PATH]
#        enve-clone [OPTIONS] <BACKUP> [PATH]
#        enve-clone [OPTIONS] default
# Environment encapsulation tool
#
# Common Options:
#     -f, --fire         enter the enve shell
#
#
# __noexec__=true


# shellcheck source=libexec/enve/baselib
. "$ENVE_HOME/enve/baselib"

# shellcheck source=libexec/enve/findutils
. "$ENVE_HOME/enve/findutils"

# shellcheck source=libexec/enve/urlutils
. "$ENVE_HOME/enve/urlutils"

: '
enve-cp [OPTIONS] [-T] SOURCE DEST
enve-cp [OPTIONS] SOURCE... DEST
enve-cp [OPTIONS] -t DEST SOURCE...

Target maybe follow:
    [user@]host:[path]
    scp://[user@]host[:port][/path]
    http://host[/path]
    s3://host/path
    *.tar
    *.zip
    *.tar/
    *.zip/

Source maybe follow:
    *.git
    git+http://host[/path]
    %backup[/name][#time]

Destination maybe follow:
    %tmp - copy into temporary directory
    %cache - copy into cache
    %backup[/name]

Options:
    --refresh[=PERIOD]      refresh cache when destination is "%cache"
    --update[=UPDATE]
              control which existing files are updated;
              UPDATE={all,none,none-fail,older(default)}
    -R, -r, --recursive     copy directories recursively, same as all sources ends with "/"
    -L, --dereference       always follow symbolic links in SOURCE
    -p                      same as --preserve=mode,ownership,timestamps
    -l, -d                  same as --no-dereference --preserve=links
    -f, --force             if an existing destination file cannot be opened, remove it and try again
    --remove-destination    remove each existing destination file before attempting to open it
    -n, --dry-run           show what would have been transferred
    --progress              show progress during transfer
'



