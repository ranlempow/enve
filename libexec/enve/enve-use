# default workspace is current directory
ws=.
standalone=1
while [ "$#" -gt 0 ]; do
    case "$1" in
        -w|-w=*|--worksapce|--worksapce=*)
                splitarg "$1" && { ws=$ARG; shift 1; } || {
                    isarg "${2:-}" && { ws=$2; shift 2; } || {
                        _error "workspace must assign"
                        return 1
                    }
                }
            ;;
        -S|--no-standalone)
                standalone=
                shift 1
            ;;
        -s|--shortcut)
                create_shortcut=1
                shift 1
            ;;
        -u|--update)
                update=1
                shift 1
            ;;
        kitty|kitty=*)
            splitarg "$1" && { kitty=$ARG; shift 1; } || { kitty=1; shift 1; } ;;
        zsh|zsh=*)
            splitarg "$1" && { zsh=$ARG; shift 1; } || { zsh=1; shift 1; } ;;
        # git-bash
        # wsl
