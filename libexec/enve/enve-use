            Windows__x86_64)  basename=sublime_text_build_${version}_x64.zip;;
            Windows__aarch64) basename=;;
            Darwin__*)        basename=sublime_text_build_${version}_mac.zip;;
            Linux__x86_64)    basename=sublime_text_build_${version}_x64.tar.xz;;
            Linux__aarch64)   basename=sublime_text_build_${version}_arm64.tar.xz;;
        esac
        if [ -z "$basename" ]; then
            return 1
        fi
        url=https://download.sublimetext.com/$basename
        version=$version download_app_and_unpack sublime_text "$url"
        use=$version
