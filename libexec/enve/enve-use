ensure_sublime_text() {
    match_installed_app_version sublime_text "${1:-}"
    if [ -z "$use" ]; then
        while read -r ln; do
            case $ln in
                "<h3>Build "*"</h3>")
                    version=${ln#*"<h3>Build "}
                    version=${version%"</h3>"*}
                    # echo "$version"
