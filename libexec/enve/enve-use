ensure_font() {
    fontname=${1:-CommitMono}
    url=
    case $fontname in
        # 參考 https://www.programmingfonts.org
        # Hack.tar.xz 字短稀疏，整潔
        # 0xProto.tar.xz 寬字，風格強烈，ligatures不變形
        # iA-Writer.tar.xz IBM Plex 改良版，打字機字型，數字好看
        # FiraCode.tar.xz ，FiraMono是沒有ligatures的版本
        # CommitMono.tar.xz 正規，稍稀疏，銳利，高分辨度字型
        # Recursive.tar.xz 通用型，風格稍強，飽滿，適合程式，書寫，介面
        # JetBrainsMono.tar.xz 程式友善，但比較醜
        # Maple 圓潤厚重支援中文，變化少
        [Mm]aple)
            # NF-CN: Full version, embed with icons,
            # Chinese and Japanese glyphs (With -NF-CN suffix)
            url=$(prerelease=1 filter_github_release subframe7536/maple-font \
                   MapleMono-NF-CN.zip)
            fontname=maple
            ;;
        [Hh]ack) fontname=hack-nerd; packname=Hack ;;
        0x[Pp]roto) fontname="0xproto-nerd"; packname="0xProto" ;;
        i[Aa]-[Ww]riter|i[Aa][Ww]riter) fontname=iawriter-nerd; packname=iA-Writer ;;
        [Ff]ira|[Ff]ira[Cc]ode) fontname=firecode-nerd; packname=FiraCode ;;
        [Cc]ommit|[Cc]ommit[Mm]ono) fontname=commitmono-nerd; packname=CommitMono ;;
        [Rr]ecursive) fontname=recursive-nerd; packname=Recursive ;;
        [Jj]et[Bb]rains|[Jj]et[Bb]rains[Mm]ono) fontname=jetbrainsmono-nerd; packname=JetBrainsMono ;;
        *)
            _error "font '$fontname' not found"
            return 1
            ;;
    esac
    if [ -z "$url" ]; then
        url=$(filter_github_release ryanoasis/nerd-fonts \
              "$packname.tar.xz")
    fi
    echo "$url"
    parse_github_release_url "$url"
    match_installed_app_version font-${fontname} "$version"
    if [ -z "$use" ]; then
        download_app_and_unpack font-${fontname} "$url"
        use=$version
    fi
    _info "use font-${fontname}-$use"
    get_system2
    case "$KERNEL" in
        Darwin) font_dir="$HOME/Library/Fonts";;
        Linux)  font_dir="$HOME/.local/share/fonts";;
        # TODO:
        Windows)font_dir="$LOCALAPPDATA/Microsoft/Windows/Fonts";;
    esac

    mkdir -p $font_dir
    the_fonts_dir="$ENVE_APPDIR/font-${fontname}/$use"
}


install_font() {

    fonts=$(find "$the_fonts_dir" \( -name '*.[ot]tf' \) -type f)
    cp $fonts "$font_dir"

    powershell.exe -File "$ENVE_HOME"/enve/core/windows/install-font.ps1 "$font_dir"
}

uninstall_font() {
    fonts=$(find "$the_fonts_dir" \( -name '*.[ot]tf' \) -type f)
    for font in $fonts; do
        filename=${font##*/}
        rm "$font_dir/$filename" || true
    done
}


