    echo "ENVE: $PROJECT_DIR@${ENVE_ROLES#,}" >&2
    echo "CMD : ${cmd:-}" >&2
    echo "ARGS: $*" >&2
    echo "ENVE_CONFIG_TEXT:" >&2
