            roles="$ENVE_ROLES" loaded="" \
            parse_inherit="" \
            parse_profile_optional="" \
            enve_parse_config "$ENVE_CONFIG_TEXT"; then
        _error "parse_config failed"
        return 1
    fi
    printf %s "${TABLE:-$newl}"
    return 0
