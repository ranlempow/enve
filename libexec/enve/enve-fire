if [ -z "$_main_profile" ]; then
    unset ARG_RESULT ARG_REMOTE ARG_PATH ARG_ROLES
    unset WS_CONFIG_DIR PROJECT_DIR
    parse_enve_argument "${arg:-"."}"
    if [ "${ARG_RESULT:-}" = 'repo' ]; then
        # shellcheck source=libexec/enve/urlutils
        . "$ENVE_HOME/enve/urlutils"
        repo=$(enve_clone_tmp "$arg")
        if [ -f "$repo/enve.ini" ]; then
            assign_main_profile "$repo/enve.ini"
        else
            die "'$repo' has no 'enve.ini' inside"
        fi
    elif [ -z "${ARG_REMOTE:-}" ]; then
        if [ -z "${ARG_PATH:-}" ]; then
            # default is current directory
            ARG_PATH=.
        fi
        p=$ARG_PATH
        if find_project_upward "$ARG_PATH"; then
            assign_main_profile "$PROJECT_DIR/enve.ini"
        fi
    else
        # TODO: remote
        exec ssh "$ARG_REMOTE" enve config ":$ARG_PATH"
        return 0
    fi
else
    PROJECT_DIR=${_main_profile%"/enve.ini"}
fi

if [ "${ARG_RESULT:-}" != 'repo' ]; then
    find_ws_upward "${PROJECT_DIR:-$ARG_PATH}"
    if [ -n "${WS_CONFIG_DIR:-}" ]; then
        if [ -n "${_main_profile}" ]; then
            [ -f "$WS_CONFIG_DIR/enve.ini" ] && \
                ENVE_CONFIG_TEXT="include=$WS_CONFIG_DIR/enve.ini$newl${ENVE_CONFIG_TEXT}"
        else
